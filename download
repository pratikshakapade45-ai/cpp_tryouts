#include<stdio.h>

void check();

void main()
{
    check();
}

void check()
{
    int num;
    printf("Enter a number: ");
    scanf("%d",&num);
    if(num%2==0)
    {
        printf("Number is even\n");
    }
    else if(num==0)
    {
        printf("Number is neither even nor odd\n");
    }
    else
    {
        printf("Number is odd\n");
    }
}
